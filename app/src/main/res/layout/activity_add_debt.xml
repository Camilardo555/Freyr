<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/freyr_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                app:tint="@color/freyr_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Debt"
                android:textColor="@color/freyr_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Error Banner -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Debt Scope Toggle (Personal vs Family) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debt Type"
            android:textColor="@color/freyr_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/rg_debt_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_secondary"
            android:padding="4dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_personal_debt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Personal Debt"
                android:checked="true"
                android:textColor="@color/freyr_text_primary"
                android:buttonTint="@color/freyr_primary" />

            <RadioButton
                android:id="@+id/rb_family_debt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Family Debt"
                android:textColor="@color/freyr_text_primary"
                android:buttonTint="@color/freyr_primary" />
        </RadioGroup>

        <!-- 1. Debt Name Input (Focusable, Editable, Native EditText) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debt Name / Title *"
            android:textColor="@color/freyr_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_debt_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="e.g. Laptop, Internet Bill, Groceries"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:cursorVisible="true"
            android:importantForAutofill="no"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- 2. Total Amount Input (Focusable, Numeric Keypad, Native EditText) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Amount ($) *"
            android:textColor="@color/freyr_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_debt_amount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="e.g. 3000000 or 120000"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:cursorVisible="true"
            android:importantForAutofill="no"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Family Group Settings (Visible when Family Debt is selected) -->
        <LinearLayout
            android:id="@+id/layout_family_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Family Group"
                android:textColor="@color/freyr_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_family_group"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_text"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responsible Person"
                android:textColor="@color/freyr_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_assigned_member"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_text" />
        </LinearLayout>

        <!-- 3. Description Notes Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description / Notes (Optional)"
            android:textColor="@color/freyr_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_debt_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="4"
            android:gravity="top|start"
            android:background="@drawable/bg_edit_text"
            android:hint="e.g. Monthly installment plan, 50/50 split"
            android:inputType="textMultiLine"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:cursorVisible="true"
            android:importantForAutofill="no"
            android:textColor="@color/freyr_text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save_debt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            android:text="Save Debt"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>
